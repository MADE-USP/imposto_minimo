54033:54034, 55004, 55007, 55009, 55012:55013, 55015:55016,
55019:55021, 55024, 55027:55028, 55032, 55034, 55036,
55046:55052, 55054
)
rendasAgg <- rendas %>%
group_by(COD_UPA, NUM_DOM, NUM_UC) %>%
summarise(
trabalho = sum(if_else(V9001_reduced %in% trabalho_codes, valor_mensal, 0, missing = 0)),
aluguel = sum(if_else(V9001_reduced %in% aluguel_codes, valor_mensal, 0, missing = 0)),
outras_rendas = sum(if_else(V9001_reduced %in% outras_rendas_codes, valor_mensal, 0, missing = 0)),
transferencias = sum(if_else(V9001_reduced %in% transferencias_codes, valor_mensal, 0, missing = 0)),
) %>%
ungroup()
dom <- morador %>% filter(!COND_FAMILIA %in% c(18,19)) %>% group_by(COD_UPA, NUM_DOM, NUM_UC, PESO_FINAL) %>% summarise(numpes = n())
dom <- dom %>%
left_join(rendasAgg, by = c("COD_UPA", "NUM_DOM", "NUM_UC"))
dom <- dom %>% mutate(across(c(trabalho, aluguel, outras_rendas, transferencias),
~ replace_na(., 0)))
tabelaRendaDesc <- tabelaDescritiva <- dom %>% ungroup() %>% summarise(
trabalho = sum(trabalho*PESO_FINAL)/sum(PESO_FINAL),
aluguel = sum(aluguel*PESO_FINAL)/sum(PESO_FINAL),
outras_rendas = sum(outras_rendas*PESO_FINAL)/sum(PESO_FINAL),
transferencias = sum(transferencias*PESO_FINAL)/sum(PESO_FINAL)
)
tabelaRendaDesc
View(tabelaRendaDesc)
library(tidyverse)
library(this.path)
setwd(this.dir())
load('../data/baseRendimentosIsentosPlrAdj.Rda')
pnadc_receita_final$renda_irpfepnad <- coalesce(pnadc_receita_final$rendimento_todasfontes_calibrado, pnadc_receita_final$rendimento_todasfontes)
pnadc_receita_final <- pnadc_receita_final %>%
arrange(renda_irpfepnad)
total_pobres_renda <- 0
total_pobres_numero <- 0
total_ricos_renda <- 0
total_ricos_numero <- 0
for(i in 1:nrow(pnadc_receita_final)) {
row <- pnadc_receita_final[i,]
total_pobres_renda <- total_pobres_renda + (row$renda_irpfepnad*row$peso_comcalib)
total_pobres_numero <- total_pobres_numero + row$peso_comcalib
if(total_pobres_numero>10e6){
break
}
}
pnadc_receita_final <- pnadc_receita_final %>%
arrange(desc(renda_irpfepnad))
for(i in 1:nrow(pnadc_receita_final)) {
row <- pnadc_receita_final[i,]
total_ricos_renda <- total_ricos_renda + (row$renda_irpfepnad*row$peso_comcalib)
total_ricos_numero <- total_ricos_numero + row$peso_comcalib
if(total_ricos_renda>total_pobres_renda){
break
}
}
individuo_mais_rico_renda <- 1321919521.95/12
pobres_renda <- 0
pobres_numero <- 0
pnadc_receita_final <- pnadc_receita_final %>%
arrange(renda_irpfepnad)
for(i in 1:nrow(pnadc_receita_final)) {
row <- pnadc_receita_final[i,]
pobres_renda <- pobres_renda + (row$renda_irpfepnad*row$peso_comcalib)
pobres_numero <- pobres_numero + row$peso_comcalib
if(pobres_renda>individuo_mais_rico_renda){
break
}
}
pobres_numero
pobres_numero/1e6
