library(PNADcIBGE) # Puxar dados do IBGE
library(this.path) # Organização de diretórios
library(logger) # Logger
setwd(this.dir())
dir <- './rawPNAD/'
for(year in 2012:2022) {
log_info("Extraindo dados do ano {year}")
if(year %in% c(2020,2021)) {
rawData <- get_pnadc(year = year, interview = 5, labels = F, design = F)
} else {
rawData <- get_pnadc(year = year, interview = 1, labels = F, design = F)
}
rawData <- rawData %>% mutate(VD4046 = VD4046*CO1)
selectedData <- rawData %>%
select(c("Ano", "UF", "ID_DOMICILIO", "VD4046", "V1032")) %>%
rename(rendimento_todasfontes = VD4046,
peso_dom_comcalib = V1032) %>%
filter(rendimento_todasfontes>0)
finalDir <- paste0(dir, "pnad", year, ".rds")
log_info("Salvando dados em {finalDir}")
saveRDS(selectedData, finalDir)
rm(rawData)
rm(selectedData)
gc()
}
gc()
library(tidyverse) # Manipulação de dados
library(PNADcIBGE) # Puxar dados do IBGE
library(this.path) # Organização de diretórios
library(logger) # Logger
setwd(this.dir())
dirPnads <- './rawPNAD/'
dirCorrected <- './newPNAD/'
rendasReceita <- read.csv('./Receita/Tabelas - Distribuicao.csv')
rendasReceita <- rendasReceita %>% filter(!is.na(Centil))
tamanhosGrupos <- read.csv('./Receita/Tabelas - Tamanho Centis.csv')
for (year in 2012:2022) {
pnad <- readRDS(paste0(dirPnads, "pnad", year, ".rds"))
log_info("Processando a PNAD de {year}")
target <- tamanhosGrupos %>% filter(Ano==year) %>% pull(Tamanho.do.Centil)
pnad <- pnad %>% arrange(desc(rendimento_todasfontes))
receitaDados <- rendasReceita %>% select(c("Centil", paste0("AC.",year)))
v <- pnad$peso_dom_comcalib
grupo <- 1 # Primeiro grupo
ref <- 1 # Ponto inicial do primeiro grupo: sempre 1
output <- c()
for(i in 1:length(v)){
if(sum(v[ref:i]) <= target){
} else {
grupo <- grupo + 1
ref <- i + 1}
output[i] <- grupo
}
pnad <- pnad %>% mutate(grupo = output,
populacao_acumulada = cumsum(peso_dom_comcalib),
grupo_receita = 101 - grupo)
pnadc_receita <- full_join(pnad, receitaDados,
by = c("grupo_receita" = "Centil"), keep=TRUE)
pnadc_receita <- pnadc_receita %>% rename(renda_total_receita = paste0("AC.",year))
pnadc_receita <- pnadc_receita %>%
group_by(grupo_receita) %>%
mutate(renda_anual_todasfontes_centesimo = sum(rendimento_todasfontes*peso_dom_comcalib)*12,
fator_expansão = renda_total_receita/renda_anual_todasfontes_centesimo,
rendimento_todasfontes_calibrado = if_else(fator_expansão >= 1, rendimento_todasfontes*fator_expansão,
rendimento_todasfontes)) %>%
ungroup() %>%
rename(peso_comcalib = peso_dom_comcalib) %>%
mutate(rendimento_todasfontes_calibrado = coalesce(rendimento_todasfontes_calibrado,
rendimento_todasfontes))
renda_media_antes <- sum(pnadc_receita$rendimento_todasfontes*pnadc_receita$peso_comcalib)/sum(pnadc_receita$peso_comcalib)
renda_media_depois <- sum(pnadc_receita$rendimento_todasfontes_calibrado*pnadc_receita$peso_comcalib)/sum(pnadc_receita$peso_comcalib)
log_info("Renda média antes da correção: {renda_media_antes}")
log_info("Renda média depois da correção: {renda_media_depois}")
finalDir <- paste0(dirCorrected, "pnadReceita", year, ".rds")
log_info("Salvando dados em {finalDir}")
saveRDS(pnadc_receita, finalDir)
}
library(tidyverse)
library(this.path)
setwd(this.dir())
source('utils/IneqFunctions.R')
StatsGini(pnadc_receita$rendimento_todasfontes, pnadc_receita$peso_comcalib)
StatsGini(pnadc_receita$rendimento_todasfontes_calibrado, pnadc_receita$peso_comcalib)
