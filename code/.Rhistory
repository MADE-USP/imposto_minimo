"PL 1.087" = "#eb52ff",
"Proposta Progressiva" = "#45ff66"
)) +
xlab("Posição na Distribuição de Renda") +
ylab("Alíquota Efetiva (%)") +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
legend.position = "bottom"
)
