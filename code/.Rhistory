library(tidyverse)
library(this.path)
setwd(this.dir())
morador <- readRDS('./Dados/MORADOR.rds')
outros_rendimentos <- readRDS('./Dados/OUTROS_RENDIMENTOS.rds')
rendimento_trabalho <- readRDS('./Dados/RENDIMENTO_TRABALHO.rds')
rendimento_trabalho <- rendimento_trabalho %>% mutate(V9001_mut = floor(V9001/100))
outros_rendimentos <- outros_rendimentos %>% mutate(V9001_mut = floor(V9001/100))
rendimento_trabalho <- rendimento_trabalho %>% mutate(V9011 = replace_na(V9011, 1))
outros_rendimentos <- outros_rendimentos %>% mutate(V9011 = replace_na(V9011, 1))
outros_rendimentos <- outros_rendimentos %>% mutate(valor = V8500_DEFLA*FATOR_ANUALIZACAO*V9011/12)
rendimento_trabalho <- rendimento_trabalho %>% mutate(valor = V8500_DEFLA*FATOR_ANUALIZACAO*V9011/12)
trabalho_codes <- c(53001:53004, 54015:54018, 54020, 54036:54038,
55001:55002, 55011, 55026, 55035, 55037:55043,
55045, 55062:55063, 53005, 55003, 53006)
transferencias_codes <- c(
# 1.2.1
54001:54002, 55022:55023, 55064,
# 1.2.2
54003:54004, 55065,
# 1.2.3
54005, 54023, 55025, 55033, 55066,
# 1.2.4
54010:54012, 54024,
# 1.2.5
54007, 54026, 54032, 55030,
# 1.2.6
54006, 54013:54014, 54019, 54021:54022, 54025, 54027:54031, 54035,
55017:55018, 55029, 55031, 55055:55059
)
aluguel_codes <- c(54008:54009)
outras_rendas_codes <- c(
54033:54034, 55004, 55007, 55009, 55012:55013, 55015:55016,
55019:55021, 55024, 55027:55028, 55032, 55034, 55036,
55046:55052, 55054
)
rendimento_trabalho_filtrado <- rendimento_trabalho %>% filter(V9001_mut %in% trabalho_codes)
transferencias <- outros_rendimentos %>% filter(V9001_mut %in% transferencias_codes)
outros_rendas <- outros_rendimentos %>% filter(V9001_mut %in% transferencias_codes)
aluguel <- outros_rendimentos %>% filter(V9001_mut %in% aluguel_codes)
aluguel <- aluguel %>% group_by(COD_UPA, NUM_DOM, NUM_UC) %>% summarise(rend_aluguel = sum(valor))
outros_rendas <- outros_rendas %>% group_by(COD_UPA, NUM_DOM, NUM_UC) %>% summarise(rend_outras_rendas = sum(valor))
transferencias <- transferencias %>% group_by(COD_UPA, NUM_DOM, NUM_UC) %>% summarise(rend_trans = sum(valor))
trabalho_r <- rendimento_trabalho_filtrado %>% group_by(COD_UPA, NUM_DOM, NUM_UC) %>% summarise(rend_trab = sum(valor))
dom <- morador %>% filter(!COND_FAMILIA %in% c(18,19)) %>% group_by(COD_UPA, NUM_DOM, NUM_UC, PESO_FINAL) %>% summarise(numpes = n())
dom <- dom %>%
left_join(aluguel, by = c("COD_UPA", "NUM_DOM", "NUM_UC")) %>%
left_join(outros_rendas, by = c("COD_UPA", "NUM_DOM", "NUM_UC")) %>%
left_join(transferencias, by = c("COD_UPA", "NUM_DOM", "NUM_UC")) %>%
left_join(trabalho_r, by = c("COD_UPA", "NUM_DOM", "NUM_UC"))
dom <- dom %>% mutate(across(c(rend_aluguel, rend_outras_rendas, rend_trans, rend_trab),
~ replace_na(., 0)))
dom <- dom %>% mutate(renda_monetaria = rend_aluguel + rend_outras_rendas + rend_trans + rend_trab)
dom <- dom %>% mutate(peso_familia = numpes*PESO_FINAL)
renda_monetaria_media <- sum(dom$renda_monetaria*dom$PESO_FINAL)/sum(dom$PESO_FINAL)
renda_monetaria_media <- sum(dom$rend_trab*dom$PESO_FINAL)/sum(dom$PESO_FINAL)
renda_monetaria_media
renda_monetaria_media <- sum(dom$rend_trans*dom$PESO_FINAL)/sum(dom$PESO_FINAL)
renda_monetaria_media
rendasAgg <- rendas %>%
group_by(COD_UPA, NUM_DOM, NUM_UC) %>%
summarise(
trabalho = sum(if_else(V9001_reduced %in% trabalho_codes, valor_mensal, 0, missing = 0)),
aluguel = sum(if_else(V9001_reduced %in% aluguel_codes, valor_mensal, 0, missing = 0)),
outras_rendas = sum(if_else(V9001_reduced %in% outras_rendas_codes, valor_mensal, 0, missing = 0)),
transferencias = sum(if_else(V9001_reduced %in% transferencias_codes, valor_mensal, 0, missing = 0)),
) %>%
ungroup()
