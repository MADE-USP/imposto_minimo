desp_veiculo <- readRDS('./Dados/DESPESA_VEICULO.rds')
servicos_dom <- readRDS('./Dados/SERVICO_DOMS.rds')
desp_outras <- readRDS('./Dados/OUTRAS_DESPESAS.rds')
