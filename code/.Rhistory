setwd('D:/Imputacao - RF - PNAD')
source("IneqFunctions.R")
load('baseRendimentosIsentos.Rda')
pnadc_receita <- pnadc_receita_final
#Cenário base:
faixa1=(22847.76/12)
faixa2=(33919.80/12)
faixa3=(45012.60/12)
faixa4=(55976.16/12)
aliquota1=0.075
aliquota2=0.15
aliquota3=0.225
aliquota4=0.275
calcula_irpf_mensal <- function(renda) {
if((renda<=faixa2) && (renda>faixa1)){
irpf_pago <- (renda-faixa1)*aliquota1
}
else if((renda<=faixa3) && (renda>faixa2)){
irpf_pago <- (renda-faixa2)*aliquota2 + (faixa2-faixa1)*aliquota1
}
else if((renda<=faixa4) && (renda>faixa3)){
irpf_pago <- (renda-faixa3)*aliquota3 + (faixa3-faixa2)*aliquota2 + (faixa2-faixa1)*aliquota1
}
else if(renda>faixa4){
irpf_pago <- (renda-faixa4)*aliquota4+(faixa4-faixa3)*aliquota3 + (faixa3-faixa2)*aliquota2 + (faixa2-faixa1)*aliquota1
}
else{
irpf_pago <-0
}
return(irpf_pago)
}
pnadc_receita$renda_irpfepnad <- coalesce(pnadc_receita$rendimento_todasfontes_calibrado, pnadc_receita$rendimento_todasfontes)
pnadc_receita$renda <- coalesce(pnadc_receita$`Renda Total`,0)
pnadc_receita$renda_trib <- coalesce(pnadc_receita$`Rendimento Tributável`,0)
pnadc_receita$base_c <- coalesce(pnadc_receita$`Base de Cálculo`,0)
pnadc_receita$medicas <- coalesce(pnadc_receita$`Despesas Médicas`,0)
pnadc_receita$base_c_m <- pnadc_receita$base_c + pnadc_receita$medicas
pnadc_receita <- pnadc_receita %>% mutate(irpf_mensal_m = map_dbl(base_c_m, calcula_irpf_mensal))
pnadc_receita <- pnadc_receita %>% mutate(irpf_mensal_deducoes = map_dbl(base_c, calcula_irpf_mensal))
pnadc_receita <- pnadc_receita %>% mutate(centis_total = weighted_ntile(renda_irpfepnad, peso_comcalib, 100))
groupedPnad <- pnadc_receita %>% group_by(centis_total) %>% summarise(
'Aliquota Efetiva (Renda Total)' = (sum(irpf_mensal_deducoes*peso_comcalib)/sum(renda_irpfepnad*peso_comcalib))*100,
'Aliquota Efetiva (Renda Tributável)' = (sum(irpf_mensal_deducoes*peso_comcalib)/sum(renda_trib*peso_comcalib))*100,
'Aliquota Efetiva (Base de Cálculo)' = (sum(irpf_mensal_deducoes*peso_comcalib)/sum(base_c*peso_comcalib))*100,
)
groupedPnad <- groupedPnad %>%
mutate(across(everything(), ~replace_na(., 0)))
groupedPnad <- groupedPnad %>% rename("Centis da Renda Total" = centis_total)
write.csv(groupedPnad, "aliquota_centis.csv", row.names = F)
