library(tidyverse) # Manipulação de dados
library(PNADcIBGE) # Puxar dados do IBGE
library(this.path) # Organização de diretórios
library(logger) # Logger
setwd(this.dir())
dir <- './rawPNAD/'
for(year in 2012:2022) {
log_info("Extraindo dados do ano {year}")
if(year %in% c(2020,2021)) {
rawData <- get_pnadc(year = year, interview = 5, labels = F, design = F)
} else {
rawData <- get_pnadc(year = year, interview = 1, labels = F, design = F)
}
selectedData <- rawData %>%
select(c("Ano", "UF", "ID_DOMICILIO", "VD4046", "V1032")) %>%
rename(rendimento_todasfontes = VD4046,
peso_dom_comcalib = V1032)
finalDir <- paste0(dir, "pnad", year, ".rds")
log_info("Salvando dados em {finalDir}")
saveRDS(selectedData, finalDir)
rm(rawData)
rm(selectedData)
gc()
}
gc()
